{
  "name": "pi-crust-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only observability UI for the pi-crust \u2014 polls crust.db in a target repo.",
  "scripts": {
    "dev": "vite",
    "server": "bun run server/index.ts",
    "dev:all": "bun run server/index.ts & vite",
    "build": "tsc --noEmit && vite build",
    "preview": "bun run server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource/play": "^5.3.0",
    "lucide-react": "^0.544.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20",
    "@types/bun": "^1.1.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "playwright": "1.64.1",
    "typescript": "^5.7.2",
    "vite": "^7"
  }
}
