{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noEmit": true,
    // NOT composite (see runtime/tsconfig.json's own comment for what that
    // setting is for): server/trace-db-fixture.test.ts imports SCHEMA and
    // MIGRATIONS from runtime/domains/trace/src/data/trace-db.ts
    // (COVERAGE-VISUALIZER-SERVER.md, 1.1.2), and a composite project must
    // list every transitively-imported file in its own `include`, which a
    // cross-package import defeats. The root tsconfig.json's bare
    // `tsc --noEmit` convenience silently checks none of this project's
    // files as a result; `mise run typecheck:visualizer`
    // (`tsc --noEmit -p apps/visualizer`) is unaffected and remains the
    // check that gates the repository.

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      // Not this app's code: the settlement module both trees import, kept
      // in one place so the runtime and the UI cannot disagree about what a
      // failure is. Mirrored in vite.config.ts, which resolves it at build.
      "@typedefs": ["../../lib/typedefs/index.ts"],
      "@sqlite": ["../../lib/sqlite/index.ts"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "server/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "../../lib/typedefs/**/*.ts",
    "../../lib/sqlite/**/*.ts"
  ]
}
