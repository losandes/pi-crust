{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noEmit": true,
    // NOT composite (see runtime/tsconfig.json's own comment for what that
    // setting is for): server/trace-db-fixture.test.ts imports SCHEMA and
    // MIGRATIONS from runtime/modules/data/trace-db.ts
    // (COVERAGE-VISUALIZER-SERVER.md, 1.1.2), and a composite project must
    // list every transitively-imported file in its own `include`, which a
    // cross-package import defeats. The root tsconfig.json's bare
    // `tsc --noEmit` convenience silently checks none of this project's
    // files as a result; `bun run typecheck:visualizer`
    // (`tsc --noEmit -p apps/visualizer`) is unaffected and remains the
    // check that gates the repository.

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["shared/**/*.ts", "server/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
