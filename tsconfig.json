/* Visit https://aka.ms/tsconfig to read more about this file */
{
  /*
   * This project has no source files of its own — `runtime/` and
   * `apps/visualizer/` are independent TypeScript projects with their own
   * compiler options (module system, lib, JSX, path aliases), and merging
   * their settings into one shared config would check each tree under the
   * other's rules. The `typecheck` task in `mise.toml` reflects that:
   * it runs `bun x tsc --noEmit -p runtime` and
   * `bun x tsc --noEmit -p apps/visualizer` as two separate invocations, both
   * from the repository root, which remains how this repository verifies
   * itself; see AGENTS.md.
   *
   * This file exists only so a bare `bun x tsc --noEmit` run from the
   * repository root — with no project argument — type-checks both projects instead of
   * finding no tsconfig.json and failing before it reads a single file.
   * `files: []` plus `references` checks each project under its own
   * settings, the same as running it from that project's own directory.
   *
   * `apps/visualizer` is no longer `composite` (see its own tsconfig.json
   * for why), so this bare invocation now silently checks zero of its
   * files rather than erroring — the reference below still resolves, it
   * just has nothing composite to build. `mise run typecheck` never goes
   * through this file; it is the gate.
   */
  "files": [],
  "references": [{ "path": "./runtime" }, { "path": "./apps/visualizer" }]
}
